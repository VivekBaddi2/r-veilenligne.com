---
const siteUrl = Astro.site;
if (!siteUrl) {
	throw new Error('Set the production site URL in astro.config.mjs.');
}

const canonicalUrl = new URL('/', siteUrl).href;
const socialImageUrl = new URL('/og-reveil-en-ligne.png', siteUrl).href;
const pageTitle = 'Réveil en ligne gratuit avec musique | Alarme en ligne';
const pageDescription =
	'Utilisez ce réveil en ligne gratuit : réglez une alarme, choisissez ou importez une musique, testez le son et gardez l’onglet ouvert.';
const applicationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Réveil en ligne',
	url: canonicalUrl,
	description: pageDescription,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any',
	inLanguage: 'fr-FR',
	isAccessibleForFree: true,
	featureList: [
		'Réveil à une heure précise',
		'Sons intégrés ou fichier audio personnel',
		'Aperçu et réglage du volume',
		'Répétition avec délai réglable',
		'Affichage plein écran et mode nuit',
		'Préférences conservées dans le navigateur',
	],
};
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			try {
				if (localStorage.getItem('reveil-en-ligne-theme') === 'dark') {
					document.documentElement.dataset.theme = 'dark';
				}
			} catch (error) {
				console.warn('Impossible de charger le thème enregistré.', error);
			}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Réveil en ligne" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Réveil en ligne gratuit avec affichage de l’heure et une alarme personnalisable" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
